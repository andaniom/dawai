# =============================================================================
# DAWAI — Environment Variables Template
# Copy this file to .env and fill real values. NEVER commit .env to git.
# =============================================================================

# === Database (PostgreSQL) ===================================================
# Development: uses docker-compose postgres container
# Production:  use managed PostgreSQL (Supabase, Railway, Render) or self-hosted
POSTGRES_USER=dawai
POSTGRES_PASSWORD=change_me_to_a_real_password_min_24_chars
POSTGRES_DB=dawai

# Connection string — update host for production
# Development (docker):
DATABASE_URL=postgres://dawai:${POSTGRES_PASSWORD}@postgres:5432/dawai?sslmode=disable
# Production example (SSL required):
# DATABASE_URL=postgres://dawai:${POSTGRES_PASSWORD}@db.example.com:5432/dawai?sslmode=require

# === Backend (Go API) =======================================================
PORT=8080

# JWT — generate with: openssl rand -base64 32
# MUST be ≥ 32 characters
JWT_SECRET=change_me_to_a_random_32_char_string

# === MinIO (S3-compatible object storage) ====================================
# Development only — production should use S3, GCS, or Supabase Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dawai-files
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# === Frontend (Next.js) ======================================================
# Public API URL — must be accessible from browser
NEXT_PUBLIC_API_URL=http://localhost:8080

# NextAuth
# Development:
NEXTAUTH_URL=http://localhost:3000
# Production (with SSL):
# NEXTAUTH_URL=https://dawai.yourschool.edu
AUTH_SECRET=change_me_to_a_random_32_char_string

# === Google OAuth (optional) =================================================
# Create at: https://console.cloud.google.com/apis/credentials
# Development: use localhost in authorized redirect URIs
# Production:  add your domain to authorized redirect URIs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === SMTP / Email (optional — for notifications) =============================
# Use any SMTP provider: Mailgun, SendGrid, Postmark, or your mailserver
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.mailgun.org
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# === Production Docker Compose Override =======================================
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
NEXTAUTH_URL=https://your-domain.com
API_URL_INTERNAL=http://api:8080
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# === Woodpecker CI Secrets (set in CI settings, NOT in .env) =================
# jwt_secret      → ${JWT_SECRET}
# db_password     → ${POSTGRES_PASSWORD}
# auth_secret     → ${AUTH_SECRET}
# smtp_password   → ${SMTP_PASS}
# google_client_id     → ${GOOGLE_CLIENT_ID}
# google_client_secret → ${GOOGLE_CLIENT_SECRET}
